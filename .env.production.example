# ==============================================================================
# JIRA MCP SERVER - PRODUCTION VPS ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env on your VPS and configure your secrets:
#   cp .env.production.example .env
#   chmod 600 .env
# ==============================================================================

# --- Reverse Proxy & Domain Settings ---
# Opção Recomendada (HTTPS válido automático via Let's Encrypt sem precisar registrar domínio):
# Utiliza o serviço DNS sslip.io que aponta diretamente para o seu IP:
MCP_DOMAIN=187.127.20.59.sslip.io

# Alternativa (HTTPS com certificado autoassinado direto no IP ou domínio próprio):
# MCP_DOMAIN=187.127.20.59
# MCP_DOMAIN=mcp-jira.yourdomain.com

# HTTP Basic Authentication Credentials for MCP client access
MCP_AUTH_USER=mcpuser

# Hashed password for Caddy (Generate using: docker run --rm caddy:2.9-alpine caddy hash-password --plaintext "YourStrongPassword")
MCP_AUTH_PASSWORD_HASH=$2a$14$V0AkmFv6G65QePqf7qXp4u1V10oUoXh1a6Vl2J0vG20aO1q2W3E4q

# --- MCP Server Settings ---
PORT=8080
MCP_ENDPOINT=/mcp

# --- Jira Server Connection & Secrets (Remote only, never committed) ---
JIRA_BASE_URL=https://jira.yourcompany.com
JIRA_USERNAME=service-account-jira
JIRA_PASSWORD=your-secure-jira-password
JIRA_COOKIE=
JIRA_SPRINT_FIELD_ID=customfield_10007
JIRA_RELATED_PRD_FIELD_ID=customfield_10005
